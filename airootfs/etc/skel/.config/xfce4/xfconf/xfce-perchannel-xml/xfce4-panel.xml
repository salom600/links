<?xml version="1.0" encoding="UTF-8"?>

<!--
  Lumina Linux — XFCE Panel Layout
  - == == == == == == == == == == == == == == == ==
  Mimics the Windows 11 taskbar:
    [Start (Whisker)] [Pinned apps] . . . [Task list] . . . [Tray] [Volume] [Network] [Clock]
  Single panel, bottom, 48 px tall, with acrylic blur provided by picom.
-->

<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="panel-1" type="empty">
      <!-- - == == == == - Placement - == == == == - -->
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>    <!-- Whisker Menu (Start) -->
        <value type="int" value="2"/>    <!-- Separator -->
        <value type="int" value="3"/>    <!-- Firefox launcher -->
        <value type="int" value="4"/>    <!-- File Manager launcher -->
        <value type="int" value="5"/>    <!-- Terminal launcher -->
        <value type="int" value="6"/>    <!-- Pamac App Store launcher -->
        <value type="int" value="7"/>    <!-- Separator (expandable) -->
        <value type="int" value="8"/>    <!-- Task list (open windows) -->
        <value type="int" value="9"/>    <!-- Separator (expandable) -->
        <value type="int" value="10"/>   <!-- System tray -->
        <value type="int" value="11"/>   <!-- PulseAudio volume -->
        <value type="int" value="12"/>   <!-- Network -->
        <value type="int" value="13"/>   <!-- Power -->
        <value type="int" value="14"/>   <!-- Notifications -->
        <value type="int" value="15"/>   <!-- Clock -->
        <value type="int" value="16"/>   <!-- Show Desktop -->
      </property>

      <!-- - == == == == - Appearance - == == == == - -->
      <property name="background-style" type="uint" value="0"/>     <!-- 0 = none (transparent; picom provides blur) -->
      <property name="background-alpha" type="uint" value="75"/>    <!-- 75% opacity for acrylic effect -->
      <property name="mode" type="uint" value="0"/>                 <!-- 0 = horizontal -->
      <property name="size" type="uint" value="48"/>                <!-- 48 px tall (Win11-like) -->
      <property name="length" type="uint" value="100"/>             <!-- 100% screen width -->
      <property name="autohide-behavior" type="uint" value="0"/>    <!-- 0 = never autohide -->
      <property name="icon-size" type="uint" value="0"/>            <!-- 0 = use global -->
      <property name="span-monitors" type="bool" value="false"/>
      <property name="nrows" type="uint" value="1"/>
      <property name="output-name" type="string" value="Primary"/>
      <property name="enter-opacity" type="uint" value="100"/>
      <property name="leave-opacity" type="uint" value="75"/>
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="wrap" type="bool" value="false"/>
    </property>
  </property>

  <!-- ============ Plugin definitions ============ -->

  <!-- 1. Whisker Menu (Start button) -->
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="lumina-start-symbolic"/>
      <property name="button-title" type="string" value="Applications"/>
      <property name="button-single-row" type="bool" value="false"/>
      <property name="show-button-title" type="bool" value="false"/>
      <property name="view-mode" type="uint" value="1"/>
      <property name="category-icon-size" type="uint" value="1"/>
      <property name="item-icon-size" type="uint" value="2"/>
      <property name="icon-size" type="uint" value="2"/>
      <property name="menu-width" type="uint" value="500"/>
      <property name="menu-height" type="uint" value="500"/>
      <property name="recent" type="array">
        <value type="string" value="firefox.desktop"/>
        <value type="string" value="thunar.desktop"/>
        <value type="string" value="xfce4-terminal.desktop"/>
        <value type="string" value="pamac-manager.desktop"/>
      </property>
      <property name="favorites" type="array">
        <value type="string" value="firefox.desktop"/>
        <value type="string" value="thunar.desktop"/>
        <value type="string" value="xfce4-terminal.desktop"/>
        <value type="string" value="pamac-manager.desktop"/>
        <value type="string" value="org.libreoffice.LibreOffice.desktop"/>
        <value type="string" value="vlc.desktop"/>
        <value type="string" value="discord.desktop"/>
        <value type="string" value="spotify.desktop"/>
        <value type="string" value="steam.desktop"/>
      </property>
      <property name="command-switchuser" type="string" value="dm-tool switch-to-greeter"/>
      <property name="command-lockscreen" type="string" value="xflock4"/>
      <property name="command-settings" type="string" value="xfce4-settings-manager"/>
      <property name="command-menueditor" type="string" value="menulibre"/>
      <property name="show-category-icons" type="bool" value="true"/>
      <property name="show-command" type="bool" value="true"/>
      <property name="show-settings" type="bool" value="true"/>
      <property name="show-about" type="bool" value="false"/>
      <property name="show-favorites" type="bool" value="true"/>
      <property name="show-recent" type="bool" value="true"/>
      <property name="show-recent-first" type="bool" value="false"/>
      <property name="position-search-alternative" type="bool" value="true"/>
      <property name="position-commands" type="bool" value="true"/>
      <property name="position-categories" type="uint" value="2"/>
      <property name="position-categories-horizontal" type="bool" value="true"/>
    </property>

    <!-- 2. Separator after Start -->
    <property name="plugin-2" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
      <property name="expand" type="bool" value="false"/>
    </property>

    <!-- 3. Firefox launcher -->
    <property name="plugin-3" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="firefox.desktop"/>
      </property>
    </property>

    <!-- 4. File Manager launcher -->
    <property name="plugin-4" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="thunar.desktop"/>
      </property>
    </property>

    <!-- 5. Terminal launcher -->
    <property name="plugin-5" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="xfce4-terminal.desktop"/>
      </property>
    </property>

    <!-- 6. Pamac App Store launcher -->
    <property name="plugin-6" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="pamac-manager.desktop"/>
      </property>
    </property>

    <!-- 7. Expandable separator (pushes task list to center) -->
    <property name="plugin-7" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
      <property name="expand" type="bool" value="true"/>
    </property>

    <!-- 8. Task list (open windows) — Win11-style centered -->
    <property name="plugin-8" type="string" value="tasklist">
      <property name="show-labels" type="bool" value="true"/>
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="switch-workspace-on-unresponsive" type="bool" value="true"/>
      <property name="grouping" type="bool" value="true"/>
      <property name="include-all-workspaces" type="bool" value="false"/>
      <property name="include-all-monitors" type="bool" value="true"/>
      <property name="sort-order" type="uint" value="4"/>
      <property name="window-scrolling" type="bool" value="true"/>
      <property name="middle-click" type="uint" value="1"/>
    </property>

    <!-- 9. Expandable separator (pushes tray to right) -->
    <property name="plugin-9" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
      <property name="expand" type="bool" value="true"/>
    </property>

    <!-- 10. System tray -->
    <property name="plugin-10" type="string" value="systray">
      <property name="size-max" type="uint" value="22"/>
      <property name="names-visible" type="array">
        <value type="string" value="networkmanager applet"/>
        <value type="string" value="blueman"/>
        <value type="string" value="pamac-tray"/>
        <value type="string" value="xfce4-power-manager"/>
      </property>
      <property name="names-hidden" type="array">
        <value type="string" value="clipman"/>
      </property>
    </property>

    <!-- 11. PulseAudio volume control -->
    <property name="plugin-11" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
      <property name="show-notifications" type="bool" value="true"/>
      <property name="mixer-command" type="string" value="pavucontrol"/>
    </property>

    <!-- 12. Network Manager -->
    <property name="plugin-12" type="string" value="nm-applet"/>

    <!-- 13. Power manager -->
    <property name="plugin-13" type="string" value="power-manager-plugin">
      <property name="show-panel-label" type="uint" value="0"/>
      <property name="handle-brightness-keys" type="bool" value="true"/>
    </property>

    <!-- 14. Notification plugin -->
    <property name="plugin-14" type="string" value="notifications">
      <property name="do-not-disturb" type="bool" value="false"/>
      <property name="show-log" type="bool" value="true"/>
      <property name="log-max-size" type="uint" value="50"/>
    </property>

    <!-- 15. Clock (right-aligned, Win11-style) -->
    <property name="plugin-15" type="string" value="clock">
      <property name="digital-format" type="string" value="%H:%M"/>
      <property name="tooltip-format" type="string" value="%A %d %B %Y"/>
      <property name="mode" type="uint" value="2"/>
      <property name="show-seconds" type="bool" value="false"/>
      <property name="show-meridiem" type="bool" value="false"/>
      <property name="binary-mode" type="uint" value="0"/>
      <property name="layout" type="uint" value="0"/>
    </property>

    <!-- 16. Show Desktop -->
    <property name="plugin-16" type="string" value="showdesktop"/>
  </property>
</channel>

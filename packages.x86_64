xf86-video-amdgpu
xf86-video-ati
xf86-video-intel
xf86-video-nouveau
xf86-video-vesa
# xf86-video-vmware was removed — modern VMware uses open-vm-tools + kernel drivers.
open-vm-tools
mesa
vulkan-radeon
vulkan-intel
vulkan-nouveau
vulkan-icd-loader
vulkan-mesa-layers
lib32-mesa
lib32-vulkan-radeon
lib32-vulkan-intel
lib32-vulkan-icd-loader
glmark2
vulkan-tools

# ---------- NVIDIA (proprietary, optional but expected by gamers) ----------
# The legacy 'nvidia' and 'nvidia-dkms' packages were renamed to
# 'nvidia-open' and 'nvidia-open-dkms' in 2024. NVIDIA now defaults to
# the open-source kernel modules on Turing+ (RTX 20xx and newer).
nvidia-open
nvidia-open-dkms
nvidia-utils
lib32-nvidia-utils
nvidia-settings


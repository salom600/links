# =============================================================================
# Lumina Linux — Live ISO package list (x86_64)
# =============================================================================
# This file is consumed by `mkarchiso` to build the live environment.
# Lines starting with `#` and blank lines are ignored.
#
# IMPORTANT: Do NOT use inline comments (text after a package name on the
# same line). mkarchiso's parser strips the comment but PRESERVES the
# trailing whitespace before the comment, which causes pacman to receive
# "mtools                    " (with trailing spaces) as a package name and
# report "target not found: mtools" even though the package exists.
# Use full-line comments only, like this one.
#
# Order: base -> kernel -> firmware -> networking -> display -> DE -> apps
# =============================================================================

# ---------- Base system ----------
base
base-devel
linux
linux-headers
linux-firmware
linux-firmware-bnx2x
linux-firmware-liquidio
linux-firmware-marvell
intel-ucode
amd-ucode
systemd
systemd-sysvcompat
openssh
sudo
which
fsarchiver
parted
gptfdisk
ntfs-3g
dosfstools
mtools
smartmontools

# ---------- Bootloader & install tools ----------
# syslinux was removed from Arch in 2025 (now AUR-only) — built via CI.
# We use UEFI-only boot (uefi.systemd-boot) — see profiledef.sh.
grub
efibootmgr
os-prober
memtest86+-efi
edk2-shell
arch-install-scripts
archinstall
# calamares is AUR-only as of 2025 — built via CI and installed from [lumina].

# ---------- Package manager & app store ----------
pacman-contrib
reflector
flatpak
xdg-desktop-portal
xdg-desktop-portal-gtk
# pamac-aur and paru-bin are AUR packages — built via CI and installed from [lumina].

